{
  "name": "@banodoco/timeline-composition",
  "version": "0.0.15",
  "private": true,
  "description": "Portable timeline evaluator and Remotion composition with scoped element registries.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "remotion": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation.d.ts",
      "import": "./dist/evaluation.js",
      "remotion": "./dist/evaluation.js",
      "default": "./dist/evaluation.js"
    },
    "./theme-api": {
      "types": "./dist/theme-api.d.ts",
      "import": "./dist/theme-api.js",
      "remotion": "./dist/theme-api.js",
      "default": "./dist/theme-api.js"
    },
    "./registry.generated": {
      "types": "./dist/registry.generated.d.ts",
      "import": "./dist/registry.generated.js",
      "remotion": "./dist/registry.generated.js",
      "default": "./dist/registry.generated.js"
    },
    "./effects.generated": {
      "types": "./dist/effects.generated.d.ts",
      "import": "./dist/effects.generated.js",
      "remotion": "./dist/effects.generated.js",
      "default": "./dist/effects.generated.js"
    },
    "./animations.generated": {
      "types": "./dist/animations.generated.d.ts",
      "import": "./dist/animations.generated.js",
      "remotion": "./dist/animations.generated.js",
      "default": "./dist/animations.generated.js"
    },
    "./transitions.generated": {
      "types": "./dist/transitions.generated.d.ts",
      "import": "./dist/transitions.generated.js",
      "remotion": "./dist/transitions.generated.js",
      "default": "./dist/transitions.generated.js"
    },
    "./registries": {
      "types": "./dist/registries.d.ts",
      "import": "./dist/registries.js",
      "remotion": "./dist/registries.js",
      "default": "./dist/registries.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run gen-registry:check && node scripts/build.mjs",
    "build:ts": "node scripts/build-typescript.mjs",
    "build:test": "node scripts/build-typescript.mjs --test",
    "gen-registry": "node --import tsx scripts/gen-registry.ts",
    "gen-registry:check": "node --import tsx scripts/gen-registry.ts --check",
    "test": "npm run build:test && node --import ./typescript/tests/register-extensionless.mjs --test typescript/test-dist/tests/*.test.js scripts/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "peerDependencies": {
    "@remotion/layout-utils": "4.0.509",
    "@remotion/media": "4.0.509",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.509"
  },
  "devDependencies": {
    "@remotion/layout-utils": "4.0.509",
    "@remotion/media": "4.0.509",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "18.3.7",
    "@types/react-test-renderer": "^18.3.1",
    "esbuild": "0.27.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "^18.3.1",
    "remotion": "4.0.509",
    "tsx": "^4.20.3",
    "typescript": "5.9.3"
  }
}
